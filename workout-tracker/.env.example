# GitHub OAuth app credentials (create at github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Random secret for session signing (openssl rand -hex 32)
BETTER_AUTH_SECRET=change_me_to_a_random_32_char_string

# Where this server is publicly reachable (for OAuth redirect URIs)
BASE_URL=http://localhost:47832

# SQLite file path
DATABASE_URL=./workout-tracker.db

PORT=47832
FRONTEND_PORT=31905
